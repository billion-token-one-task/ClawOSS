{
  "agents": {
    "defaults": {
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 130000,
        "keepRecentTokens": 15000,
        "maxHistoryShare": 0.35,
        "recentTurnsPreserve": 3,
        "identifierPolicy": "strict",
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 2
        },
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 30000,
          "prompt": "Before compaction, write current state to workspace files: 1) Active sub-agents and their repos to memory/impl-spawn-state.md, 2) PR follow-up queue to memory/pr-followup-state.md, 3) Work queue status to memory/work-queue.md, 4) Any pending scout reports. Then compact."
        },
        "postCompactionSections": [
          "Orchestrator + Sub-Agent Architecture",
          "Safety Defaults",
          "Context Rot Prevention"
        ]
      },
      "model": {
        "primary": "minimax/MiniMax-M2.7",
        "fallbacks": ["kimi-coding/k2p5"]
      },
      "subagents": {
        "model": "minimax/MiniMax-M2.7",
        "maxConcurrent": 1,
        "archiveAfterMinutes": 1440,
        "maxChildrenPerAgent": 15,
        "maxSpawnDepth": 2,
        "announceTimeoutMs": 5000
      }
    },
    "list": [
      {
        "id": "clawoss",
        "default": true,
        "name": "ClawOSS",
        "workspace": "__WORKSPACE_PATH__",
        "model": "minimax/MiniMax-M2.7",
        "tools": {
          "profile": "coding"
        },
        "humanDelay": {
          "mode": "off"
        },
        "heartbeat": {
          "model": "minimax/MiniMax-M2.7",
          "session": "main",
          "target": "none",
          "prompt": "External-controller mode. Read /home/ubuntu/projects/codex/ClawOSS/workspace/HEARTBEAT.md and follow the current prompt goal and output contract.",
          "lightContext": true
        }
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "minimax": {
        "baseUrl": "https://api.minimaxi.com/v1",
        "apiKey": "${MINIMAX_API_KEY}",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "MiniMax-M2.7",
            "name": "MiniMax M2.7",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0.5, "output": 1.5, "cacheRead": 0.125, "cacheWrite": 0.5 },
            "contextWindow": 204800,
            "maxTokens": 131072
          }
        ]
      }
    }
  },
  "acp": {
    "defaultAgent": "codex"
  },
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "messages": {
    "queue": {
      "mode": "steer",
      "debounceMs": 500,
      "cap": 10
    }
  },
  "tools": {
    "sessions_spawn": {
      "attachments": {
        "enabled": true
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity"
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "applyPatch": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "skills": {
    "load": {
      "watch": true
    }
  },
  "logging": {
    "level": "info"
  }
}
