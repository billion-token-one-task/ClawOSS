{
  "agents": {
    "defaults": {
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 130000,
        "keepRecentTokens": 15000,
        "maxHistoryShare": 0.35,
        "recentTurnsPreserve": 3,
        "identifierPolicy": "strict",
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 2
        },
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 30000,
          "prompt": "Before compaction, write current state to workspace files: 1) Active sub-agents and their repos to memory/impl-spawn-state.md, 2) PR follow-up queue to memory/pr-followup-state.md, 3) Work queue status to memory/work-queue.md, 4) Any pending scout reports. Then compact."
        },
        "postCompactionSections": [
          "Orchestrator + Sub-Agent Architecture",
          "Safety Defaults",
          "Context Rot Prevention"
        ]
      },
      "model": {
        "primary": "__LLM_PROVIDER__/__LLM_MODEL_SIMPLE__",
        "fallbacks": ["__LLM_PROVIDER__/__LLM_MODEL_COMPLEX__"]
      },
      "subagents": {
        "model": "__LLM_PROVIDER__/__LLM_MODEL_COMPLEX__",
        "maxConcurrent": 14,
        "archiveAfterMinutes": 1440,
        "maxChildrenPerAgent": 15,
        "maxSpawnDepth": 2,
        "announceTimeoutMs": 5000
      }
    },
    "list": [
      {
        "id": "clawoss",
        "default": true,
        "name": "ClawOSS",
        "workspace": "__WORKSPACE_PATH__",
        "model": "__LLM_PROVIDER__/__LLM_MODEL_SIMPLE__",
        "tools": {
          "profile": "coding"
        },
        "humanDelay": {
          "mode": "off"
        },
        "heartbeat": {
          "every": "5m",
          "model": "__LLM_PROVIDER__/__LLM_MODEL_SIMPLE__",
          "session": "main",
          "target": "none",
          "prompt": "External-controller mode. Read /home/ubuntu/projects/codex/ClawOSS/workspace/HEARTBEAT.md and follow the current prompt goal and output contract.",
          "lightContext": true
        }
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "__LLM_PROVIDER__": {
        "baseUrl": "__LLM_BASE_URL__",
        "apiKey": "${LLM_API_KEY}",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "__LLM_MODEL_COMPLEX__",
            "name": "Complex Model (Opus-tier)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": __INPUT_COST_PER_M_COMPLEX__, "output": __OUTPUT_COST_PER_M_COMPLEX__ },
            "contextWindow": __LLM_CONTEXT_WINDOW__,
            "maxTokens": __LLM_MAX_TOKENS__
          },
          {
            "id": "__LLM_MODEL_SIMPLE__",
            "name": "Simple Model (Sonnet-tier)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": __INPUT_COST_PER_M_SIMPLE__, "output": __OUTPUT_COST_PER_M_SIMPLE__ },
            "contextWindow": __LLM_CONTEXT_WINDOW__,
            "maxTokens": __LLM_MAX_TOKENS__
          }
        ]
      }
    }
  },
  "acp": {
    "defaultAgent": "codex"
  },
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "messages": {
    "queue": {
      "mode": "steer",
      "debounceMs": 500,
      "cap": 10
    }
  },
  "tools": {
    "sessions_spawn": {
      "attachments": {
        "enabled": true
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity"
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "applyPatch": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "skills": {
    "load": {
      "watch": true
    }
  },
  "logging": {
    "level": "info"
  }
}
