{
  "agents": {
    "defaults": {
      "bootstrapMaxChars": 12000,
      "bootstrapTotalMaxChars": 40000,
      "contextInjection": "continuation-skip",
      "timeoutSeconds": 900,
      "llm": {
        "idleTimeoutSeconds": 300
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 130000,
        "keepRecentTokens": 15000,
        "maxHistoryShare": 0.35,
        "recentTurnsPreserve": 3,
        "identifierPolicy": "strict",
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 2
        },
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 30000,
          "prompt": "Before compaction, write current state to workspace files: 1) Active sub-agents and their repos to memory/impl-spawn-state.md, 2) PR follow-up queue to memory/pr-followup-state.md, 3) Work queue status to memory/work-queue.md, 4) Any pending scout reports. Then compact."
        },
        "postCompactionSections": [
          "Orchestrator + Sub-Agent Architecture",
          "Safety Defaults",
          "Context Rot Prevention"
        ]
      },
      "model": {
        "primary": "__PRIMARY_MODEL__",
        "fallbacks": []
      },
      "subagents": {
        "model": "__PRIMARY_MODEL__",
        "maxConcurrent": 14,
        "archiveAfterMinutes": 1440,
        "maxChildrenPerAgent": 15,
        "maxSpawnDepth": 2,
        "announceTimeoutMs": 5000
      }
    },
    "list": [
      {
        "id": "clawoss",
        "default": true,
        "name": "ClawOSS",
        "workspace": "__WORKSPACE_PATH__",
        "model": "__PRIMARY_MODEL__",
        "tools": {
          "profile": "coding"
        },
        "humanDelay": {
          "mode": "off"
        },
        "heartbeat": {
          "every": "5m",
          "model": "__PRIMARY_MODEL__",
          "session": "main",
          "target": "none",
          "prompt": "Resume the ClawOSS heartbeat loop. Read workspace/HEARTBEAT.md from disk and execute it. Goal: merged PRs. Prioritize new implementation work before follow-ups, obey dashboard pause and budget controls immediately, use the configured GitHub username explicitly instead of @me, and never idle while valid work exists. If bootstrap files look truncated, re-read the needed files from disk before acting.",
          "lightContext": false
        }
      }
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {}
  },
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "messages": {
    "queue": {
      "mode": "steer",
      "debounceMs": 500,
      "cap": 10
    }
  },
  "tools": {
    "sessions_spawn": {
      "attachments": {
        "enabled": true
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity"
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "applyPatch": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "skills": {
    "load": {
      "watch": true
    }
  },
  "logging": {
    "level": "info"
  }
}
