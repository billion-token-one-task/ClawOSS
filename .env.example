# ClawOSS Environment — copy to .env and fill in values
# DO NOT COMMIT .env — it is gitignored

# === LLM Provider (required) ===

# Model identifier — format: provider/model-id (e.g. openai/gpt-4o-mini)
LLM_MODEL=openai/gpt-4o-mini

# API base URL for your LLM provider
LLM_BASE_URL=https://api.openai.com/v1

# API key for your LLM provider
LLM_API_KEY=your-key-here

# Provider name used in openclaw.json (optional — overrides the prefix extracted from LLM_MODEL)
# Set this when your LLM_BASE_URL is a proxy (tokenrouter, openrouter, etc.) and the
# auto-detected name (e.g. "openai") conflicts with OpenClaw's built-in provider.
# Example: LLM_PROVIDER_NAME=tokenrouter
# LLM_PROVIDER_NAME=

# Model ID sent to the API (optional — defaults to full LLM_MODEL value)
# Use when the proxy expects a different model ID format than LLM_MODEL.
# LLM_MODEL_API_ID=gpt-4o-mini

# Context window size (tokens)
LLM_CONTEXT_WINDOW=128000

# Max output tokens per request
LLM_MAX_TOKENS=16384

# Pricing (used for dashboard cost tracking)
LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60

# === GitHub (required) ===

# GitHub Personal Access Token — needs public_repo scope at minimum
GITHUB_TOKEN=ghp_your-token-here

# GitHub identity for PRs (defaults shown)
GITHUB_USERNAME=BillionClaw
GITHUB_EMAIL=billionclaw+clawoss@users.noreply.github.com

# === Dashboard (optional) ===

DASHBOARD_URL=https://clawoss-dashboard.vercel.app
CLAW_API_KEY=your-shared-secret-here

# Token budget — agent stops when total spend reaches this amount (USD)
# Set to 0 or leave unset to disable
TOKEN_BUDGET_USD=20.00
BUDGET_CHECK_INTERVAL=60

# ─────────────────────────────────────────────────────────────────────────────
# Provider examples — copy the block you want and fill in LLM_API_KEY
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

# Anthropic
# LLM_MODEL=anthropic/claude-haiku-4-5
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_INPUT_COST_PER_MILLION=0.80
# LLM_OUTPUT_COST_PER_MILLION=4.00

# DeepSeek
# LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_INPUT_COST_PER_MILLION=0.14
# LLM_OUTPUT_COST_PER_MILLION=0.28

# OpenRouter (any model)
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

# MiniMax (original default)
# LLM_MODEL=minimax/MiniMax-M2.7
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_INPUT_COST_PER_MILLION=0.50
# LLM_OUTPUT_COST_PER_MILLION=1.50

# Kimi Code (original fallback)
# LLM_MODEL=kimi-coding/k2p5
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_INPUT_COST_PER_MILLION=0.60
# LLM_OUTPUT_COST_PER_MILLION=3.00
